#!/bin/sh
set -eu
# Refuse to replace a running installed copy. Never terminate the user's app.
if /bin/ps -axo comm= | /usr/bin/awk '/\/Applications\/(Webinar Nihongo|RTranslate)\.app\/Contents\/MacOS\/WebinarNihongo/ { found=1 } END { exit !found }'; then
    echo 'R翻訳 / RTranslate を終了してからインストールしてください。' >&2
    exit 1
fi
exit 0
