{
  "manifest_version": 3,
  "name": "R翻訳",
  "version": "0.4.9",
  "description": "英語の動画とページを日本語で聴く。ページ本文の読み上げにも対応。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "R翻訳",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "32": "toolbar-32.png",
      "48": "toolbar-48.png",
      "64": "toolbar-64.png",
      "128": "toolbar-128.png"
    }
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "26.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "audio-worklet.js",
        "hls-decoder.mjs",
        "mp4box.all.mjs",
        "styp-BV5G3FS-.mjs",
        "rolldown-runtime-CNh9ExCG.mjs",
        "timeline.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png",
    "1024": "icon-1024.png"
  }
}
